# Sprint 4 AI Coach: remote model calls are off by default.
# Values prefixed VITE_ are PUBLIC browser build variables: never put API keys there.
VITE_ASR_RELAY_ENABLED=false
VITE_ASR_RELAY_MODE=live
VITE_ASR_RELAY_URL=
VITE_AI_LIVE_FEEDBACK_ENABLED=false
VITE_AI_LIVE_MOCK=false
VITE_AI_PAID_REVIEW_ENABLED=false

# Server-side AI pilot configuration. Keep keys and the access code private.
AI_FEEDBACK_ENABLED=false
AI_LIVE_FEEDBACK_ENABLED=false
AI_LIVE_MOCK=false
AI_LIVE_MAX_CALLS_PER_INSTANCE=0
AI_GATEWAY_MODEL=alibaba/qwen3.7-flash
# Vercel provides an OIDC token. Set a key only for local or direct-provider use.
AI_GATEWAY_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
AI_DEMO_ACCESS_CODE=

# Server-side Qwen uses services/qwen-asr-relay/.env.example
# This is a separate persistent WebSocket service, not a Vercel function.

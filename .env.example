# Tick-Tock AI Coach — every provider is OFF by default.
# Client flags: safe to expose. NEVER put keys or access codes in VITE_* variables.
VITE_ASR_RELAY_ENABLED=false
VITE_ASR_RELAY_MODE=live
VITE_ASR_RELAY_URL=
VITE_AI_LIVE_FEEDBACK_ENABLED=false
VITE_AI_LIVE_MOCK=false
VITE_AI_PAID_REVIEW_ENABLED=false

# Server-only Vercel variables. Configure only after owner billing approval.
AI_FEEDBACK_ENABLED=false
AI_LIVE_FEEDBACK_ENABLED=false
AI_LIVE_MOCK=false
AI_SPEND_CAP_CONFIRMED=false
AI_LIVE_MAX_CALLS_PER_INSTANCE=0
DEEPSEEK_API_KEY=
AI_DEMO_ACCESS_CODE=

# Qwen ASR requires a separate persistent WS relay under services/qwen-asr-relay/.
# See its .env.example and docs/AI-COACH-INTEGRATION.md.
